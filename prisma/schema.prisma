generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String?        @db.Uuid
  location_id      String?        @db.Uuid
  actor_profile_id String?        @db.Uuid
  action           String
  target_type      String
  target_id        String?
  outcome          audit_outcome
  request_id       String
  ip_hash          String?
  before_json      Json?
  after_json       Json?
  metadata         Json           @default("{}")
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  profiles         profiles?      @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)
  locations        locations?     @relation(fields: [organization_id, location_id], references: [organization_id, id], onDelete: Cascade, onUpdate: NoAction, map: "audit_logs_location_fk")
  organizations    organizations? @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_profile_id, created_at(sort: Desc)], map: "audit_logs_actor_created_idx")
  @@index([location_id, created_at(sort: Desc)], map: "audit_logs_location_created_idx")
  @@index([organization_id, created_at(sort: Desc)], map: "audit_logs_org_created_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auth_sessions {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
