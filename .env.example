NODE_ENV=development
APP_ENV=local
# Synthetic MSI trial only; never enable in production.
UNIFIED_LOCAL_TRIAL=false
UNIFIED_LOCAL_TRIAL_ORIGINS=
BEAUTY_LOCAL_CREDENTIAL_FILE=
BEAUTY_LOCAL_PORT=3100
BEAUTY_LOCAL_LAN_HOST=
MEMBER_VALUE_TEST_ONLY=false
PAYROLL_TEST_ONLY=false
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100
PUBLIC_APP_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT_SECONDS=20

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
ABUSE_HASH_SECRET=replace-with-at-least-32-random-characters
TOKEN_DERIVATION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_CLIENT_IP_HEADER=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost
TURNSTILE_ALLOW_TEST_KEYS=false

CRON_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

ALLOW_DEMO_SEED=false
ENABLE_LOCAL_AUTH_STUB=false
PAYMENT_PROVIDER=disabled
NOTIFICATION_PROVIDER=disabled
