{
  "name": "beauty-saas-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant beauty booking SaaS built on the StallOrder backend architecture.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/setup-local.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-local.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/status-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-local.ps1",
    "postinstall": "prisma generate && patch-package",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "db:seed": "cross-env ALLOW_DEMO_SEED=true tsx prisma/seed.ts",
    "import:massage": "tsx scripts/import-massage-data.ts",
    "production:bootstrap-qa": "node scripts/bootstrap-production-qa.mjs",
    "production:check": "node scripts/production-readiness.mjs",
    "production:smoke": "node scripts/production-smoke-test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "patch-package": "8.0.1",
    "prisma": "^6.19.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "brace-expansion": "5.0.8",
    "sharp": "$sharp"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
