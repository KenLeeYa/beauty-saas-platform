{
  "name": "beauty-saas-platform",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant beauty booking SaaS built on the StallOrder backend architecture.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/setup-local.ps1",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/start-local.ps1",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/status-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev/stop-local.ps1",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unified": "node scripts/test-unified-synthetic.mjs",
    "local:msi": "node scripts/msi-local.mjs start",
    "test:msi": "node scripts/msi-local.mjs test",
    "test:msi:ui": "node scripts/msi-local.mjs ui",
    "booking:legacy-preview": "tsx scripts/preview-legacy-booking-import.ts",
    "test:e2e": "playwright test",
    "test:e2e:local": "npm run test:e2e:local:desktop && npm run test:e2e:local:mobile && npm run test:e2e:local:restore",
    "test:e2e:local:desktop": "npm run db:seed && tsx scripts/reset-local-test-rate-limits.ts && cross-env PLAYWRIGHT_APP_URL=http://127.0.0.1:3100 PLAYWRIGHT_REUSE_EXISTING_SERVER=true playwright test --project=desktop-chrome",
    "test:e2e:local:mobile": "npm run db:seed && tsx scripts/reset-local-test-rate-limits.ts && cross-env PLAYWRIGHT_APP_URL=http://127.0.0.1:3100 PLAYWRIGHT_REUSE_EXISTING_SERVER=true playwright test --project=mobile-chrome",
    "test:e2e:local:restore": "npm run db:seed && tsx scripts/reset-local-test-rate-limits.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local",
    "db:seed": "cross-env ALLOW_DEMO_SEED=true tsx prisma/seed.ts",
    "import:massage": "tsx scripts/import-massage-data.ts",
    "production:bootstrap-qa": "node scripts/bootstrap-production-qa.mjs",
    "production:check": "node scripts/production-readiness.mjs",
    "production:smoke": "node scripts/production-smoke-test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.89.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^6.19.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "sharp": "$sharp"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
